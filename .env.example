# Copiá este archivo como ".env" y completá las claves. Nunca lo subas a internet.

# Clave de la API de Claude (console.anthropic.com). Sin ella, el diagnóstico funciona en modo demostración.
ANTHROPIC_API_KEY=

# Clave de Resend (resend.com) para que el formulario mande mails. Sin ella, los mensajes se guardan en mensajes-recibidos.txt.
RESEND_API_KEY=

# Opcionales
# CONTACTO_DESTINO=mcataldo@nodaldevelopments.com
# CONTACTO_REMITENTE=Sitio Nodal <web@nodaldevelopments.com>
